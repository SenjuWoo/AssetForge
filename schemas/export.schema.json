{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SenjuWoo/AssetForge/schemas/export.schema.json",
  "title": "Export record",
  "type": "object",
  "required": ["schema", "target", "asset", "status", "checks", "files"],
  "properties": {
    "schema": {"const": 1},
    "target": {"type": "string"},
    "title": {"type": "string"},
    "asset": {"type": "string"},
    "kind": {"enum": ["mesh", "texture"]},
    "created": {"type": "string"},
    "status": {"enum": ["PASS", "WARNING", "FAIL"]},
    "checks": {"type": "array", "items": {"type": "object"}},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "engine_import": {"const": "NOT_TESTED"}
  }
}
