{
  "schema": 1,
  "id": "comfy-import",
  "title": "Import comfy-forge output",
  "description": "Copy the newest generated images from a comfy-forge output folder into an asset.",
  "input": {
    "name": "source",
    "kind": "directory",
    "required": true
  },
  "params": {
    "limit": {
      "type": "integer",
      "default": 1
    },
    "thumbnail": {
      "type": "integer",
      "default": 256
    }
  },
  "steps": [
    "comfykit.detect",
    "comfykit.import",
    "image.thumbnail",
    "asset.record"
  ]
}
